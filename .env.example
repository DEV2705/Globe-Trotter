# Copy to .env for local development. Never commit .env — it is gitignored.

# --- Database -----------------------------------------------------------
# Pooled connection. Serverless functions open far more connections than
# Postgres accepts directly, so this must point at a pooler (pgbouncer) in
# production. Locally, a plain connection string is fine.
# Percent-encode special characters in the password: @ becomes %40.
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres?schema=public"

# Unpooled connection, used only for schema operations (prisma db push) which
# a pooler cannot carry. Set it to the same value as DATABASE_URL if your
# provider does not offer a pooler.
DIRECT_URL="postgresql://postgres:password@localhost:5432/postgres?schema=public"

# --- Auth ---------------------------------------------------------------
# Signs the session cookie. Use a long random value and a DIFFERENT one in
# production — generate with: openssl rand -base64 48
JWT_SECRET=""

# --- Inference ----------------------------------------------------------
# Powers itinerary generation, the travel assistant, and packing lists.
# Get one at https://console.groq.com/keys
# Leave blank to run the app with those features cleanly disabled.
GROQ_API_KEY=""

# --- URLs ---------------------------------------------------------------
# Base URL used for public share links and social preview tags.
# Optional on Vercel: falls back to the deployment hostname automatically.
# Set it once you have a custom domain. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
